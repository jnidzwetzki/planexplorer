# Example .env file for dev:full mode

# Database connection settings
PGHOST=localhost
PGPORT=5432
PGUSER=your_db_user
PGPASSWORD=your_db_password
PGDATABASE=your_db_name

# MySQL connection settings (used when the "Server Proxy (MySQL)" backend is selected)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

PORT=4000

# Restrict which browser origin may call the proxy server (CORS). Should match
# the origin the Next.js app runs on.
ALLOWED_ORIGIN=http://localhost:3000

# Optional shared secret required on every request to the proxy server.
# This is NOT a real secret: the frontend is a browser app and has to embed it in
# a NEXT_PUBLIC_* variable, which is inlined into the shipped JS bundle and visible
# to anyone who opens devtools on the page. Its only purpose is to stop other
# websites/tabs open in your browser from silently sending requests to this local
# proxy (CSRF/drive-by protection) - it does not authenticate a human user. Leave
# both empty to disable the check entirely (backward compatible default).
PROXY_SHARED_SECRET=
# Must equal PROXY_SHARED_SECRET above; read by the Next.js frontend.
NEXT_PUBLIC_PROXY_SHARED_SECRET=
